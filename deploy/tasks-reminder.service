# /etc/systemd/system/tasks-reminder.service
# YOUR_USER と /home/YOUR_USER/tasks_reminder は環境に合わせて書き換えてください。
[Unit]
Description=Google Tasks reminder Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=
WorkingDirectory=/home/YOUR_USER/tasks_reminder
ExecStart=/home/YOUR_USER/tasks_reminder/.venv/bin/python -m tasks_reminder
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
