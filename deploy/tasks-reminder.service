# /etc/systemd/system/tasks-reminder.service
# YOUR_USER と /home/YOUR_USER/Tasks_Reminder はお使いの環境のあなたのユーザー名に揃えてください。whoamiコマンドで確認できます。
[Unit]
Description=Google Tasks reminder Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/Tasks_Reminder
ExecStart=/home/YOUR_USER/Tasks_Reminder/.venv/bin/python -m tasks_reminder
Restart=on-failure
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
